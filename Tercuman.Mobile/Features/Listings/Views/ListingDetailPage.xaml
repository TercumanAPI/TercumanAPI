<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Tercuman.Mobile.Features.Listings.ViewModels"
             xmlns:listing="clr-namespace:Tercuman.Contracts.DTOs.Listing;assembly=Tercuman.Contracts"
             x:Class="Tercuman.Mobile.Features.Listings.Views.ListingDetailPage"
             Title="İlan Detayı"
             x:DataType="vm:ListingDetailViewModel"
             BackgroundColor="#F3F4F6">

    <Grid>
        <ActivityIndicator IsRunning="{Binding IsLoading}" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" 
                           Color="#4B49AC"
                           ZIndex="1"/>

        <RefreshView IsRefreshing="{Binding IsRefreshing}" 
                     Command="{Binding RefreshCommand}" 
                     RefreshColor="#4B49AC" 
                     IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">

            <ScrollView Padding="15">
                <VerticalStackLayout Spacing="15">

                    <Label Text="{Binding Listing.Title}" FontSize="22" FontAttributes="Bold" TextColor="#1F2937"/>

                    <Border StrokeShape="RoundRectangle 12" HeightRequest="200" HorizontalOptions="Fill" StrokeThickness="0">
                        <Image Source="turkish_flag.png" Aspect="AspectFill"/>
                    </Border>

                    <Border StrokeShape="RoundRectangle 8" Padding="15" BackgroundColor="White" StrokeThickness="1" Stroke="#E5E7EB">
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="{Binding Listing.Price, StringFormat='{0:N0}'}" FontSize="24" FontAttributes="Bold" TextColor="#4B49AC"/>
                            <Label Text="TL" FontSize="18" FontAttributes="Bold" TextColor="#4B49AC" VerticalOptions="End" Margin="0,0,0,3"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Border StrokeShape="RoundRectangle 8" Padding="15" BackgroundColor="White" StrokeThickness="1" Stroke="#E5E7EB">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="İlan No:" TextColor="#6B7280" FontSize="14"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Listing.ListingNo}" HorizontalOptions="End" FontAttributes="Bold" TextColor="#EF4444"/>

                                <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" Color="#F3F4F6" Margin="0,5"/>

                                <Label Grid.Row="2" Grid.Column="0" Text="Kategori:" TextColor="#6B7280" FontSize="14"/>
                                <Label Grid.Row="2" Grid.Column="1"
                                       Text="{Binding Listing.CategoryName}"
                                       HorizontalOptions="End"
                                       FontAttributes="Bold"/>


                                <BoxView Grid.Row="3" Grid.ColumnSpan="2" HeightRequest="1" Color="#F3F4F6" Margin="0,5"/>

                                <Label Grid.Row="4" Grid.Column="0" Text="Şehir:" TextColor="#6B7280" FontSize="14"/>
                                <Label Grid.Row="4" Grid.Column="1"
                                       Text="{Binding Listing.CityName}"
                                       HorizontalOptions="End"
                                       FontAttributes="Bold"/>

                                <BoxView Grid.Row="5" Grid.ColumnSpan="2" HeightRequest="1" Color="#F3F4F6" Margin="0,5"/>

                                <Label Grid.Row="6" Grid.Column="0" Text="Uzmanlık Dilleri:" TextColor="#6B7280" FontSize="14"/>
                                <Label Grid.Row="6" Grid.Column="1"
                                       Text="{Binding Listing.Languages}"
                                       HorizontalOptions="End"
                                       FontAttributes="Bold"
                                       TextColor="#4B49AC"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border StrokeShape="RoundRectangle 8" Padding="15" BackgroundColor="White" StrokeThickness="1" Stroke="#E5E7EB">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="İlan Açıklaması" FontSize="16" FontAttributes="Bold" TextColor="#1F2937"/>
                            <BoxView HeightRequest="1" Color="#E5E7EB"/>
                            <Label Text="{Binding Listing.Description}" FontSize="14" TextColor="#4B5563" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border StrokeShape="RoundRectangle 8" Padding="15" BackgroundColor="#F9FAFB" StrokeThickness="1" Stroke="#E5E7EB">
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="12">
                                <Border StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" BackgroundColor="#E0E7FF" StrokeThickness="0">
                                    <Label Text="TR" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="#4B49AC"/>
                                </Border>
                                <VerticalStackLayout>
                                    <Label Text="{Binding Listing.OwnerFullName}" FontAttributes="Bold" FontSize="16" TextColor="#1F2937"/>
                                    <Label Text="{Binding Listing.OwnerCreatedDateText, StringFormat='Katılım: {0}'}" FontSize="12" TextColor="#9CA3AF"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <Button Text="Mesaj Gönder" 
                                    Command="{Binding SendMessageCommand}"
                                    BackgroundColor="#4B49AC" 
                                    TextColor="White" 
                                    CornerRadius="8" 
                                    FontAttributes="Bold"
                                    HeightRequest="45"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>